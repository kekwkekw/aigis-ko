+    bool TextureManager::build_replacement11(ID3D11Device *device, uint64_t hash, const std::filesystem::path &inject_path, UINT original_levels, TextureDetails &details)
+    {
+        if (device == nullptr)
+            return false;
+
+        DDSImage dds;
+        if (!load_dds(path_utf8(inject_path), dds) || dds.subresources.empty())
+        {
+            Logger::get().error("[TextureManager] Failed to load injected DDS file " + path_utf8(inject_path) +
+                                (dds.load_error.empty() ? "" : " - " + dds.load_error));
+            return false;
+        }
+        return create_d3d11_replacement_from_dds(device, hash, dds, original_levels, path_utf8(inject_path), details);
+    }
