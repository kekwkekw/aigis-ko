+        snap.matched_legacy_roles.assign(m_matched_legacy_roles.begin(), m_matched_legacy_roles.end());
+        snap.matched_shared_roles.assign(m_matched_shared_roles.begin(), m_matched_shared_roles.end());
+        snap.failed_roles.assign(m_failed_roles.begin(), m_failed_roles.end());
+        snap.unknown_watched_hashes.assign(m_unknown_watched_hashes.begin(), m_unknown_watched_hashes.end());
