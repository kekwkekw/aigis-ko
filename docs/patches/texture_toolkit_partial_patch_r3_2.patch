+++ b/src/PartialPatch.cpp
@@ -0,0 +1,474 @@
+#include "PartialPatch.h"
+
+#include "Logger.h"
+#include "PathUtil.h"
+#include "RoleManifest.h"
+
+#include <wincodec.h>
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+
+namespace
+{
+    template <typename T>
+    struct ComRelease
+    {
+        T *ptr = nullptr;
+        ~ComRelease()
+        {
+            if (ptr)
+                ptr->Release();
+        }
+        T **put()
+        {
+            if (ptr)
+            {
+                ptr->Release();
+                ptr = nullptr;
+            }
+            return &ptr;
+        }
+    };
+
+    bool read_utf8_file(const std::filesystem::path &p, std::string &out)
+    {
+        std::ifstream f(p, std::ios::binary);
+        if (!f.is_open())
+            return false;
+        std::ostringstream ss;
+        ss << f.rdbuf();
+        out = ss.str();
+        return !out.empty();
+    }
+
+    size_t match_delim(const std::string &s, size_t open_pos, char open_ch, char close_ch)
+    {
+        int depth = 0;
+        bool in_str = false;
+        bool esc = false;
+        for (size_t i = open_pos; i < s.size(); ++i)
+        {
+            const char c = s[i];
+            if (esc)
+            {
+                esc = false;
+                continue;
+            }
+            if (in_str)
+            {
+                if (c == '\\')
+                    esc = true;
+                else if (c == '"')
+                    in_str = false;
+                continue;
+            }
+            if (c == '"')
+                in_str = true;
+            else if (c == open_ch)
+                ++depth;
+            else if (c == close_ch)
+            {
+                if (--depth == 0)
+                    return i;
+            }
+        }
+        return std::string::npos;
+    }
+
+    bool find_key_value_pos(const std::string &obj, const std::string &key, size_t &val_pos)
+    {
+        const std::string needle = "\"" + key + "\"";
+        const size_t kpos = obj.find(needle);
+        if (kpos == std::string::npos)
+            return false;
+        size_t colon = obj.find(':', kpos + needle.size());
+        if (colon == std::string::npos)
+            return false;
+        ++colon;
+        while (colon < obj.size() && std::isspace(static_cast<unsigned char>(obj[colon])))
+            ++colon;
+        if (colon >= obj.size())
+            return false;
+        val_pos = colon;
+        return true;
+    }
+
+    bool extract_str(const std::string &obj, const std::string &key, std::string &out)
+    {
+        size_t pos = 0;
+        if (!find_key_value_pos(obj, key, pos) || obj[pos] != '"')
+            return false;
+        ++pos;
+        std::string val;
+        bool esc = false;
+        while (pos < obj.size())
+        {
+            const char c = obj[pos++];
+            if (esc)
+            {
+                val.push_back(c);
+                esc = false;
+            }
+            else if (c == '\\')
+                esc = true;
+            else if (c == '"')
+            {
+                out = std::move(val);
+                return true;
+            }
+            else
+                val.push_back(c);
+        }
+        return false;
+    }
+
+    bool extract_u32(const std::string &obj, const std::string &key, uint32_t &out)
+    {
+        size_t pos = 0;
+        if (!find_key_value_pos(obj, key, pos) || !std::isdigit(static_cast<unsigned char>(obj[pos])))
+            return false;
+        uint64_t val = 0;
+        while (pos < obj.size() && std::isdigit(static_cast<unsigned char>(obj[pos])))
+        {
+            val = val * 10 + static_cast<uint64_t>(obj[pos] - '0');
+            ++pos;
+        }
+        out = static_cast<uint32_t>(val);
+        return true;
+    }
+
+    bool extract_bool(const std::string &obj, const std::string &key, bool default_val)
+    {
+        size_t pos = 0;
+        if (!find_key_value_pos(obj, key, pos))
+            return default_val;
+        if (obj.compare(pos, 4, "true") == 0)
+            return true;
+        if (obj.compare(pos, 5, "false") == 0)
+            return false;
+        return default_val;
+    }
+
+    std::vector<std::string> split_object_array(const std::string &src, const std::string &key)
+    {
+        std::vector<std::string> items;
+        size_t pos = 0;
+        if (!find_key_value_pos(src, key, pos) || src[pos] != '[')
+            return items;
+        const size_t rbr = match_delim(src, pos, '[', ']');
+        if (rbr == std::string::npos)
+            return items;
+        size_t cur = pos + 1;
+        while (cur < rbr)
+        {
+            const size_t lb = src.find('{', cur);
+            if (lb == std::string::npos || lb >= rbr)
+                break;
+            const size_t rb = match_delim(src, lb, '{', '}');
+            if (rb == std::string::npos || rb > rbr)
+                break;
+            items.push_back(src.substr(lb, rb - lb + 1));
+            cur = rb + 1;
+        }
+        return items;
+    }
+
+    std::vector<uint64_t> extract_hashes(const std::string &obj, const std::string &key)
+    {
+        std::vector<uint64_t> out;
+        size_t pos = 0;
+        if (!find_key_value_pos(obj, key, pos) || obj[pos] != '[')
+            return out;
+        const size_t rbr = match_delim(obj, pos, '[', ']');
+        if (rbr == std::string::npos)
+            return out;
+        size_t cur = pos + 1;
+        while (cur < rbr)
+        {
+            const size_t q1 = obj.find('"', cur);
+            if (q1 == std::string::npos || q1 >= rbr)
+                break;
+            const size_t q2 = obj.find('"', q1 + 1);
+            if (q2 == std::string::npos || q2 >= rbr)
+                break;
+            uint64_t h = 0;
+            if (TextureToolkit::RoleManifest::parse_hex64(obj.substr(q1 + 1, q2 - q1 - 1), h))
+                out.push_back(h);
+            cur = q2 + 1;
+        }
+        return out;
+    }
+
+    bool decode_png_bgra(const std::filesystem::path &path,
+                         uint32_t expected_w,
+                         uint32_t expected_h,
+                         std::vector<uint8_t> &out_bgra,
+                         std::string &out_err)
+    {
+        const HRESULT com_hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        const bool need_uninit = SUCCEEDED(com_hr);
+
+        auto cleanup = [need_uninit]() {
+            if (need_uninit)
+                CoUninitialize();
+        };
+
+        ComRelease<IWICImagingFactory> factory;
+        HRESULT hr = CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER,
+                                      IID_PPV_ARGS(factory.put()));
+        if (FAILED(hr) || !factory.ptr)
+        {
+            out_err = "CoCreateInstance(WICImagingFactory) failed";
+            cleanup();
+            return false;
+        }
+
+        ComRelease<IWICBitmapDecoder> decoder;
+        hr = factory.ptr->CreateDecoderFromFilename(path.c_str(), nullptr, GENERIC_READ,
+                                                    WICDecodeMetadataCacheOnLoad, decoder.put());
+        if (FAILED(hr) || !decoder.ptr)
+        {
+            out_err = "WIC CreateDecoderFromFilename failed";
+            cleanup();
+            return false;
+        }
+
+        ComRelease<IWICBitmapFrameDecode> frame;
+        hr = decoder.ptr->GetFrame(0, frame.put());
+        if (FAILED(hr) || !frame.ptr)
+        {
+            out_err = "WIC GetFrame failed";
+            cleanup();
+            return false;
+        }
+
+        UINT w = 0, h = 0;
+        hr = frame.ptr->GetSize(&w, &h);
+        if (FAILED(hr) || w != expected_w || h != expected_h)
+        {
+            out_err = "PNG dimensions do not match manifest rect";
+            cleanup();
+            return false;
+        }
+
+        ComRelease<IWICFormatConverter> converter;
+        hr = factory.ptr->CreateFormatConverter(converter.put());
+        if (FAILED(hr) || !converter.ptr)
+        {
+            out_err = "WIC CreateFormatConverter failed";
+            cleanup();
+            return false;
+        }
+
+        hr = converter.ptr->Initialize(frame.ptr, GUID_WICPixelFormat32bppBGRA,
+                                       WICBitmapDitherTypeNone, nullptr, 0.0, WICBitmapPaletteTypeCustom);
+        if (FAILED(hr))
+        {
+            out_err = "WIC converter->Initialize(32bppBGRA) failed";
+            cleanup();
+            return false;
+        }
+
+        const UINT stride = w * 4;
+        out_bgra.resize(static_cast<size_t>(stride) * static_cast<size_t>(h));
+        hr = converter.ptr->CopyPixels(nullptr, stride, static_cast<UINT>(out_bgra.size()), out_bgra.data());
+        if (FAILED(hr))
+        {
+            out_err = "WIC CopyPixels failed";
+            cleanup();
+            return false;
+        }
+
+        cleanup();
+        return true;
+    }
+}
+
+namespace TextureToolkit
+{
+    void PartialPatchSet::clear()
+    {
+        m_specs.clear();
+    }
+
+    bool PartialPatchSet::load_from_dir(const std::filesystem::path &patch_dir)
+    {
+        clear();
+        const std::filesystem::path manifest_path = patch_dir / "patch_manifest.json";
+        std::string json;
+        if (!read_utf8_file(manifest_path, json))
+            return false;
+
+        const auto patch_objs = split_object_array(json, "patches");
+        for (const std::string &pobj : patch_objs)
+        {
+            PartialPatchSpec spec;
+            extract_str(pobj, "name", spec.name);
+            spec.hashes = extract_hashes(pobj, "hashes");
+            extract_u32(pobj, "width", spec.width);
+            extract_u32(pobj, "height", spec.height);
+            spec.overlay_over_inject = extract_bool(pobj, "overlay_over_inject", false);
+
+            if (spec.hashes.empty() || spec.width == 0 || spec.height == 0)
+                continue;
+
+            const auto rect_objs = split_object_array(pobj, "rects");
+            bool all_ok = !rect_objs.empty();
+            for (const std::string &robj : rect_objs)
+            {
+                PartialPatchRect r;
+                std::string png_rel;
+                if (!extract_u32(robj, "x", r.x) ||
+                    !extract_u32(robj, "y", r.y) ||
+                    !extract_u32(robj, "w", r.w) ||
+                    !extract_u32(robj, "h", r.h) ||
+                    !extract_str(robj, "png", png_rel))
+                {
+                    all_ok = false;
+                    break;
+                }
+                if (r.w == 0 || r.h == 0 || r.x + r.w > spec.width || r.y + r.h > spec.height)
+                {
+                    all_ok = false;
+                    break;
+                }
+                r.png_path = path_from_utf8(png_rel);
+                if (r.png_path.is_relative())
+                    r.png_path = patch_dir / r.png_path;
+
+                std::string err;
+                if (!decode_png_bgra(r.png_path, r.w, r.h, r.bgra_pixels, err))
+                {
+                    Logger::get().error("[PartialPatch] Failed loading rect '" + path_utf8(r.png_path) + "': " + err);
+                    all_ok = false;
+                    break;
+                }
+                spec.rects.push_back(std::move(r));
+            }
+
+            if (all_ok && !spec.rects.empty())
+            {
+                Logger::get().info("[PartialPatch] Loaded patch '" + spec.name + "' (" +
+                                   std::to_string(spec.width) + "x" + std::to_string(spec.height) + ", rects=" +
+                                   std::to_string(spec.rects.size()) + ")");
+                m_specs.push_back(std::move(spec));
+            }
+        }
+        return !m_specs.empty();
+    }
+
+    const PartialPatchSpec *PartialPatchSet::find(uint64_t hash, uint32_t width, uint32_t height) const noexcept
+    {
+        for (const auto &spec : m_specs)
+        {
+            if (spec.width != width || spec.height != height)
+                continue;
+            if (std::find(spec.hashes.begin(), spec.hashes.end(), hash) != spec.hashes.end())
+                return &spec;
+        }
+        return nullptr;
+    }
+
+    bool PartialPatchSet::is_supported_dxgi_format(DXGI_FORMAT fmt) noexcept
+    {
+        return fmt == DXGI_FORMAT_B8G8R8A8_UNORM ||
+               fmt == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB ||
+               fmt == DXGI_FORMAT_B8G8R8X8_UNORM ||
+               fmt == DXGI_FORMAT_R8G8B8A8_UNORM ||
+               fmt == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    }
+
+    bool PartialPatchSet::apply_to_pixels(const PartialPatchSpec &spec,
+                                          const void *src_pixels,
+                                          uint32_t src_pitch,
+                                          DXGI_FORMAT src_fmt,
+                                          uint32_t width,
+                                          uint32_t height,
+                                          std::vector<uint8_t> &out_bgra,
+                                          PartialPatchStats &out_stats,
+                                          std::string &out_error)
+    {
+        if (!src_pixels || width != spec.width || height != spec.height || !is_supported_dxgi_format(src_fmt))
+        {
+            out_error = "unsupported source pixels or format";
+            return false;
+        }
+        const uint32_t tight_row = width * 4;
+        if (src_pitch < tight_row)
+        {
+            out_error = "source pitch smaller than tight row";
+            return false;
+        }
+
+        const bool swizzle_rgba = (src_fmt == DXGI_FORMAT_R8G8B8A8_UNORM ||
+                                   src_fmt == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB);
+
+        std::vector<uint8_t> orig_bgra(static_cast<size_t>(tight_row) * height);
+        const uint8_t *src_bytes = static_cast<const uint8_t *>(src_pixels);
+        for (uint32_t y = 0; y < height; ++y)
+        {
+            const uint8_t *sr = src_bytes + static_cast<size_t>(y) * src_pitch;
+            uint8_t *dr = orig_bgra.data() + static_cast<size_t>(y) * tight_row;
+            if (!swizzle_rgba)
+            {
+                std::memcpy(dr, sr, tight_row);
+            }
+            else
+            {
+                for (uint32_t x = 0; x < width; ++x)
+                {
+                    dr[x * 4 + 0] = sr[x * 4 + 2];
+                    dr[x * 4 + 1] = sr[x * 4 + 1];
+                    dr[x * 4 + 2] = sr[x * 4 + 0];
+                    dr[x * 4 + 3] = sr[x * 4 + 3];
+                }
+            }
+        }
+
+        out_bgra = orig_bgra;
+        std::vector<uint8_t> dirty_mask(static_cast<size_t>(width) * height, 0);
+        size_t total_png_bytes = 0;
+
+        for (const auto &r : spec.rects)
+        {
+            if (r.x + r.w > width || r.y + r.h > height || r.bgra_pixels.size() != static_cast<size_t>(r.w) * r.h * 4)
+            {
+                out_error = "patch rect geometry mismatch";
+                return false;
+            }
+            for (uint32_t row = 0; row < r.h; ++row)
+            {
+                const size_t dst_off = (static_cast<size_t>(r.y + row) * width + r.x) * 4;
+                const size_t src_off = static_cast<size_t>(row) * r.w * 4;
+                std::memcpy(out_bgra.data() + dst_off, r.bgra_pixels.data() + src_off, static_cast<size_t>(r.w) * 4);
+                std::memset(dirty_mask.data() + static_cast<size_t>(r.y + row) * width + r.x, 1, r.w);
+            }
+            std::error_code ec;
+            total_png_bytes += static_cast<size_t>(std::filesystem::file_size(r.png_path, ec));
+        }
+
+        out_stats = {};
+        out_stats.total_pixels = static_cast<size_t>(width) * height;
+        out_stats.png_total_bytes = total_png_bytes;
+        for (size_t i = 0; i < out_stats.total_pixels; ++i)
+        {
+            if (dirty_mask[i])
+            {
+                ++out_stats.patched_pixels;
+            }
+            else if (std::memcmp(out_bgra.data() + i * 4, orig_bgra.data() + i * 4, 4) == 0)
+            {
+                ++out_stats.untouched_verified_pixels;
+            }
+            else
+            {
+                out_error = "unexpected modification outside patch rect";
+                return false;
+            }
+        }
+        return true;
+    }
+}
