+    bool TextureManager::build_partial_patched11(ID3D11Device *device, uint64_t hash, const PartialPatchSpec &spec, const void *src_pixels, UINT width, UINT height, DXGI_FORMAT src_format, UINT src_pitch, UINT original_levels, TextureDetails &details)
+    {
+        if (device == nullptr || src_pixels == nullptr)
+            return false;
+        std::vector<uint8_t> patched_bgra;
+        PartialPatchStats pstats{};
+        std::string err;
+        if (!PartialPatchSet::apply_to_pixels(spec, src_pixels, src_pitch, src_format, width, height, patched_bgra, pstats, err))
+        {
+            Logger::get().error("[TextureManager] Partial patch failed for 0x" + format_hash_hex(hash) + " (" + spec.name + "): " + err);
+            return false;
+        }
+        DDSImage dds;
+        dds.width = width;
+        dds.height = height;
+        dds.depth = 1;
+        dds.mip_levels = 1;
+        dds.array_size = 1;
+        dds.format = reshade::api::format::b8g8r8a8_unorm;
+        dds.row_pitches.push_back(width * 4);
+        dds.slice_pitches.push_back(width * height * 4);
+        dds.subresources.push_back(std::move(patched_bgra));
+
+        const double pct = pstats.total_pixels ? (100.0 * pstats.patched_pixels / pstats.total_pixels) : 0.0;
+        const std::string label = "patch:" + spec.name;
+        const bool ok = create_d3d11_replacement_from_dds(device, hash, dds, original_levels, label, details);
+        if (ok)
+        {
+            Logger::get().info("[TextureManager] Partial patch applied for 0x" + format_hash_hex(hash) +
+                               " (" + spec.name + ", " + std::to_string(width) + "x" + std::to_string(height) +
+                               ", rects=" + std::to_string(spec.rects.size()) +
+                               ", patched=" + std::to_string(pstats.patched_pixels) + "/" + std::to_string(pstats.total_pixels) +
+                               " px [" + std::to_string(pct) + "%], png_bytes=" + std::to_string(pstats.png_total_bytes) +
+                               ", untouched_verified=" + std::to_string(pstats.untouched_verified_pixels) + ")");
+        }
+        return ok;
+    }
