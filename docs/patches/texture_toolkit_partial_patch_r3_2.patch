diff --git a/src/RoleManifest.cpp b/src/RoleManifest.cpp
new file mode 100644
index 0000000..6838062
--- /dev/null
+++ b/src/RoleManifest.cpp
@@ -0,0 +1,363 @@
+#include "RoleManifest.h"
+
+#include <cctype>
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+
+namespace
+{
+    using TextureToolkit::RoleEntry;
+    using TextureToolkit::RoleManifest;
+
+    bool read_file_utf8(const std::filesystem::path &path, std::string &out)
+    {
+        std::ifstream f(path, std::ios::in | std::ios::binary);
+        if (!f.is_open())
+            return false;
+        std::ostringstream ss;
+        ss << f.rdbuf();
+        out = ss.str();
+        return !out.empty();
+    }
+
+    size_t find_matching_delim(const std::string &s, size_t open_pos, char open_ch, char close_ch)
+    {
+        int depth = 0;
+        bool in_str = false;
+        bool esc = false;
+        for (size_t i = open_pos; i < s.size(); ++i)
+        {
+            const char c = s[i];
+            if (esc)
+            {
+                esc = false;
+                continue;
+            }
+            if (in_str)
+            {
+                if (c == '\\')
+                    esc = true;
+                else if (c == '"')
+                    in_str = false;
+                continue;
+            }
+            if (c == '"')
+            {
+                in_str = true;
+            }
+            else if (c == open_ch)
+            {
+                ++depth;
+            }
+            else if (c == close_ch)
+            {
+                --depth;
+                if (depth == 0)
+                    return i;
+            }
+        }
+        return std::string::npos;
+    }
+
+    bool extract_json_string(const std::string &obj, const std::string &key, std::string &out)
+    {
+        const std::string needle = "\"" + key + "\"";
+        const size_t kpos = obj.find(needle);
+        if (kpos == std::string::npos)
+            return false;
+        size_t pos = obj.find(':', kpos + needle.size());
+        if (pos == std::string::npos)
+            return false;
+        ++pos;
+        while (pos < obj.size() && std::isspace(static_cast<unsigned char>(obj[pos])))
+            ++pos;
+        if (pos >= obj.size() || obj[pos] != '"')
+            return false;
+        ++pos;
+        std::string val;
+        bool esc = false;
+        while (pos < obj.size())
+        {
+            const char c = obj[pos++];
+            if (esc)
+            {
+                val.push_back(c);
+                esc = false;
+            }
+            else if (c == '\\')
+            {
+                esc = true;
+            }
+            else if (c == '"')
+            {
+                out = std::move(val);
+                return true;
+            }
+            else
+            {
+                val.push_back(c);
+            }
+        }
+        return false;
+    }
+
+    bool extract_json_uint(const std::string &obj, const std::string &key, uint32_t &out)
+    {
+        const std::string needle = "\"" + key + "\"";
+        const size_t kpos = obj.find(needle);
+        if (kpos == std::string::npos)
+            return false;
+        size_t pos = obj.find(':', kpos + needle.size());
+        if (pos == std::string::npos)
+            return false;
+        ++pos;
+        while (pos < obj.size() && std::isspace(static_cast<unsigned char>(obj[pos])))
+            ++pos;
+        if (pos >= obj.size() || !std::isdigit(static_cast<unsigned char>(obj[pos])))
+            return false;
+        uint64_t val = 0;
+        while (pos < obj.size() && std::isdigit(static_cast<unsigned char>(obj[pos])))
+        {
+            val = val * 10 + static_cast<uint64_t>(obj[pos] - '0');
+            ++pos;
+        }
+        out = static_cast<uint32_t>(val);
+        return true;
+    }
+
+    std::vector<uint64_t> extract_hash_array(const std::string &obj, const std::string &key)
+    {
+        std::vector<uint64_t> out;
+        const std::string needle = "\"" + key + "\"";
+        const size_t kpos = obj.find(needle);
+        if (kpos == std::string::npos)
+            return out;
+        const size_t lbr = obj.find('[', kpos + needle.size());
+        if (lbr == std::string::npos)
+            return out;
+        const size_t rbr = find_matching_delim(obj, lbr, '[', ']');
+        if (rbr == std::string::npos)
+            return out;
+
+        size_t pos = lbr + 1;
+        while (pos < rbr)
+        {
+            const size_t q1 = obj.find('"', pos);
+            if (q1 == std::string::npos || q1 >= rbr)
+                break;
+            const size_t q2 = obj.find('"', q1 + 1);
+            if (q2 == std::string::npos || q2 >= rbr)
+                break;
+            uint64_t h = 0;
+            if (RoleManifest::parse_hex64(obj.substr(q1 + 1, q2 - q1 - 1), h))
+                out.push_back(h);
+            pos = q2 + 1;
+        }
+        return out;
+    }
+
+    std::string json_escape(const std::string &s)
+    {
+        std::string out;
+        out.reserve(s.size() + 8);
+        for (const unsigned char c : s)
+        {
+            if (c == '\\')
+                out += "\\\\";
+            else if (c == '"')
+                out += "\\\"";
+            else if (c == '\n')
+                out += "\\n";
+            else if (c == '\r')
+                out += "\\r";
+            else if (c == '\t')
+                out += "\\t";
+            else if (c >= 0x20)
+                out.push_back(static_cast<char>(c));
+        }
+        return out;
+    }
+
+    void write_string_array(std::ostringstream &ss, const std::vector<std::string> &items)
+    {
+        ss << "[";
+        for (size_t i = 0; i < items.size(); ++i)
+        {
+            if (i > 0)
+                ss << ", ";
+            ss << "\"" << json_escape(items[i]) << "\"";
+        }
+        ss << "]";
+    }
+
+    uint64_t dim_key(uint32_t w, uint32_t h)
+    {
+        return (static_cast<uint64_t>(w) << 32) | static_cast<uint64_t>(h);
+    }
+}
+
+namespace TextureToolkit
+{
+    bool RoleManifest::parse_hex64(const std::string &hex, uint64_t &out)
+    {
+        if (hex.empty() || hex.size() > 16)
+            return false;
+        uint64_t v = 0;
+        for (const unsigned char c : hex)
+        {
+            if (!std::isxdigit(c))
+                return false;
+            const uint64_t d = std::isdigit(c) ? static_cast<uint64_t>(c - '0')
+                                               : static_cast<uint64_t>(std::toupper(c) - 'A' + 10);
+            v = (v << 4) | d;
+        }
+        out = v;
+        return v != 0;
+    }
+
+    std::string RoleManifest::format_hex64(uint64_t value)
+    {
+        char buf[20] = {};
+        std::snprintf(buf, sizeof(buf), "%016llX", static_cast<unsigned long long>(value));
+        return buf;
+    }
+
+    void RoleManifest::clear()
+    {
+        m_loaded = false;
+        m_path.clear();
+        m_roles.clear();
+        m_hash_index.clear();
+        m_watched_dims.clear();
+    }
+
+    bool RoleManifest::load_from_file(const std::filesystem::path &path)
+    {
+        clear();
+        std::string text;
+        if (!read_file_utf8(path, text))
+            return false;
+
+        const size_t rkey = text.find("\"roles\"");
+        if (rkey == std::string::npos)
+            return false;
+        const size_t arr_open = text.find('[', rkey);
+        if (arr_open == std::string::npos)
+            return false;
+        const size_t arr_close = find_matching_delim(text, arr_open, '[', ']');
+        if (arr_close == std::string::npos)
+            return false;
+
+        size_t pos = arr_open + 1;
+        while (pos < arr_close)
+        {
+            const size_t obj_open = text.find('{', pos);
+            if (obj_open == std::string::npos || obj_open >= arr_close)
+                break;
+            const size_t obj_close = find_matching_delim(text, obj_open, '{', '}');
+            if (obj_close == std::string::npos || obj_close > arr_close)
+                break;
+
+            const std::string obj = text.substr(obj_open, obj_close - obj_open + 1);
+            RoleEntry entry;
+            if (extract_json_string(obj, "role", entry.role) && !entry.role.empty())
+            {
+                extract_json_string(obj, "status", entry.status);
+                extract_json_uint(obj, "width", entry.width);
+                extract_json_uint(obj, "height", entry.height);
+                extract_json_string(obj, "canonical_dds", entry.canonical_dds);
+                entry.vanilla_hashes = extract_hash_array(obj, "vanilla_hashes");
+                entry.legacy_hashes = extract_hash_array(obj, "legacy_hashes");
+                entry.shared_hashes = extract_hash_array(obj, "shared_hashes");
+                entry.all_hashes = extract_hash_array(obj, "all_hashes");
+
+                const size_t idx = m_roles.size();
+                for (const uint64_t h : entry.shared_hashes)
+                    m_hash_index[h] = {idx, RoleHashOrigin::Shared};
+                for (const uint64_t h : entry.vanilla_hashes)
+                    m_hash_index.try_emplace(h, RoleHashBinding{idx, RoleHashOrigin::Vanilla});
+                for (const uint64_t h : entry.legacy_hashes)
+                    m_hash_index.try_emplace(h, RoleHashBinding{idx, RoleHashOrigin::Legacy});
+                if (entry.status == "CONFIRMED" && entry.width > 0 && entry.height > 0)
+                    m_watched_dims.insert(dim_key(entry.width, entry.height));
+                m_roles.push_back(std::move(entry));
+            }
+            pos = obj_close + 1;
+        }
+
+        m_loaded = !m_roles.empty();
+        m_path = path;
+        return m_loaded;
+    }
+
+    bool RoleManifest::lookup_hash(uint64_t hash, const RoleEntry **out_role, RoleHashOrigin *out_origin) const
+    {
+        auto it = m_hash_index.find(hash);
+        if (it == m_hash_index.end())
+            return false;
+        if (out_role)
+            *out_role = &m_roles[it->second.role_index];
+        if (out_origin)
+            *out_origin = it->second.origin;
+        return true;
+    }
+
+    bool RoleManifest::is_watched_dim(uint32_t width, uint32_t height) const
+    {
+        return m_watched_dims.find(dim_key(width, height)) != m_watched_dims.end();
+    }
+
+    std::filesystem::path RoleManifest::resolve_alias_path(
+        uint64_t hash,
+        const std::unordered_map<uint64_t, std::filesystem::path> &injected_files) const
+    {
+        auto it = m_hash_index.find(hash);
+        if (it == m_hash_index.end())
+            return {};
+        const RoleEntry &r = m_roles[it->second.role_index];
+        for (const uint64_t sib : r.all_hashes)
+        {
+            auto fit = injected_files.find(sib);
+            if (fit != injected_files.end())
+                return fit->second;
+        }
+        return {};
+    }
+
+    bool RoleManifest::write_status_json(const std::filesystem::path &out_path, const RoleTelemetrySnapshot &snap)
+    {
+        std::error_code ec;
+        std::filesystem::create_directories(out_path.parent_path(), ec);
+        std::ofstream f(out_path, std::ios::out | std::ios::trunc | std::ios::binary);
+        if (!f.is_open())
+            return false;
+
+        std::ostringstream ss;
+        ss << "{\n"
+           << "  \"manifest_loaded\": " << (snap.manifest_loaded ? "true" : "false") << ",\n"
+           << "  \"manifest_path\": \"" << json_escape(snap.manifest_path) << "\",\n"
+           << "  \"roles_total\": " << snap.roles_total << ",\n"
+           << "  \"confirmed_roles\": " << snap.confirmed_roles << ",\n"
+           << "  \"profile\": \"" << json_escape(snap.profile) << "\",\n"
+           << "  \"injected_files_count\": " << snap.injected_files_count << ",\n"
+           << "  \"injected_active_count\": " << snap.injected_active_count << ",\n"
+           << "  \"failed_injections_count\": " << snap.failed_injections_count << ",\n"
+           << "  \"skipped_uploads\": " << snap.skipped_uploads << ",\n"
+           << "  \"matched_vanilla_roles\": ";
+        write_string_array(ss, snap.matched_vanilla_roles);
+        ss << ",\n  \"matched_legacy_roles\": ";
+        write_string_array(ss, snap.matched_legacy_roles);
+        ss << ",\n  \"matched_shared_roles\": ";
+        write_string_array(ss, snap.matched_shared_roles);
+        ss << ",\n  \"failed_roles\": ";
+        write_string_array(ss, snap.failed_roles);
+        ss << ",\n  \"unknown_watched_hashes\": ";
+        write_string_array(ss, snap.unknown_watched_hashes);
+        ss << "\n}\n";
+
+        const std::string txt = ss.str();
+        f.write(txt.data(), static_cast<std::streamsize>(txt.size()));
+        return f.good();
+    }
+}
diff --git a/src/RoleManifest.h b/src/RoleManifest.h
new file mode 100644
index 0000000..effe23c
--- /dev/null
+++ b/src/RoleManifest.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace TextureToolkit
+{
+    enum class RoleHashOrigin
+    {
+        None = 0,
+        Vanilla,
+        Legacy,
+        Shared,
+    };
+
+    struct RoleEntry
+    {
+        std::string role;
+        std::string status;
+        uint32_t width = 0;
+        uint32_t height = 0;
+        std::string canonical_dds;
+        std::vector<uint64_t> vanilla_hashes;
+        std::vector<uint64_t> legacy_hashes;
+        std::vector<uint64_t> shared_hashes;
+        std::vector<uint64_t> all_hashes;
+    };
+
+    struct RoleHashBinding
+    {
+        size_t role_index = 0;
+        RoleHashOrigin origin = RoleHashOrigin::None;
+    };
+
+    struct RoleTelemetrySnapshot
+    {
+        bool manifest_loaded = false;
+        std::string manifest_path;
+        size_t roles_total = 0;
+        size_t confirmed_roles = 0;
+        std::string profile = "MANIFEST_MISSING"; // VANILLA_KNOWN, LEGACY_KNOWN, SHARED_ONLY, MIXED_OR_PARTIAL_UNKNOWN, AWAITING_TEXTURES, MANIFEST_MISSING
+        std::vector<std::string> matched_vanilla_roles;
+        std::vector<std::string> matched_legacy_roles;
+        std::vector<std::string> matched_shared_roles;
+        std::vector<std::string> failed_roles;
+        std::vector<std::string> unknown_watched_hashes;
+        size_t injected_files_count = 0;
+        size_t injected_active_count = 0;
+        size_t failed_injections_count = 0;
+        uint64_t skipped_uploads = 0;
+    };
+
+    class RoleManifest
+    {
+    public:
+        bool load_from_file(const std::filesystem::path &path);
+        void clear();
+
+        bool loaded() const { return m_loaded; }
+        const std::filesystem::path &path() const { return m_path; }
+        const std::vector<RoleEntry> &roles() const { return m_roles; }
+
+        bool lookup_hash(uint64_t hash, const RoleEntry **out_role, RoleHashOrigin *out_origin) const;
+        bool is_watched_dim(uint32_t width, uint32_t height) const;
+
+        // If a sibling hash of the same role exists in injected_files, resolve hash to it.
+        std::filesystem::path resolve_alias_path(
+            uint64_t hash,
+            const std::unordered_map<uint64_t, std::filesystem::path> &injected_files) const;
+
+        static bool parse_hex64(const std::string &hex, uint64_t &out);
+        static std::string format_hex64(uint64_t value);
+        static bool write_status_json(const std::filesystem::path &out_path, const RoleTelemetrySnapshot &snap);
+
+    private:
+        bool m_loaded = false;
+        std::filesystem::path m_path;
+        std::vector<RoleEntry> m_roles;
+        std::unordered_map<uint64_t, RoleHashBinding> m_hash_index;
+        std::unordered_set<uint64_t> m_watched_dims;
+    };
+}
